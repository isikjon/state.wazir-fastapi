<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header always set Access-Control-Max-Age "86400"
    
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|bmp|tiff)$">
        Header always set Access-Control-Allow-Origin "*"
        Header always set Cache-Control "public, max-age=2592000"
        Header always set Expires "access plus 1 month"
    </FilesMatch>
    
    <FilesMatch "\.(php)$">
        Header always set Access-Control-Allow-Origin "*"
        Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-Forwarded-For"
        Header always set Access-Control-Max-Age "86400"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
    
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_FILENAME} \.(php)$
    RewriteRule ^(.*)$ $1 [L]
</IfModule>

<IfModule mod_mime.c>
    AddType application/x-httpd-php .php .php3 .php4 .php5 .phtml
    AddType image/jpeg .jpg .jpeg
    AddType image/png .png
    AddType image/gif .gif
    AddType image/webp .webp
    AddType image/bmp .bmp
    AddType image/tiff .tiff
</IfModule>

<IfModule mod_deflate.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|css|js|php)$">
        SetOutputFilter DEFLATE
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|bmp|tiff)$">
        ExpiresDefault "access plus 1 month"
    </FilesMatch>
</IfModule>

<Files "*.php">
    Order allow,deny
    Allow from all
    Require all granted
</Files>

<Files "upload.php">
    Order allow,deny
    Allow from all
    Require all granted
</Files>

<Files "image.php">
    Order allow,deny
    Allow from all
    Require all granted
</Files>

<Files "delete.php">
    Order allow,deny
    Allow from all
    Require all granted
</Files>

<Files "debug_upload.php">
    Order allow,deny
    Allow from all
    Require all granted
</Files>

<IfModule mod_security.c>
    SecRuleEngine Off
</IfModule>

php_value upload_max_filesize 300M
php_value post_max_size 300M
php_value max_execution_time 300
php_value max_input_time 300
php_value memory_limit 256M 